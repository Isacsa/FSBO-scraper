# ─── Scraper → APP Integration ───
# Required for scripts/scrape-and-push.js

# APP Fastify API base URL
APP_API_URL=http://localhost:3001

# API key for scraper authentication (generated by the APP)
SCRAPER_API_KEY=

# Tenant UUID (your tenant in the APP)
SCRAPER_TENANT_ID=

# ─── Optional: Lobstr.io (Idealista) ───
# LOBSTR_API_KEY=
