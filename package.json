{
  "name": "fsbo-scraper",
  "version": "1.0.0",
  "description": "Microserviço para extrair informações de anúncios FSBO (For Sale By Owner)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node tests/test.js",
    "test:headless": "node tests/browser-headless.test.js",
    "scrape-all": "node scripts/scrape-all.js",
    "scrape-push": "node scripts/scrape-and-push.js",
    "price-tracker": "node scripts/price-tracker.js",
    "broad-scraper": "node scripts/broad-scraper.js",
    "lobstr:squids": "node scripts/list-lobstr-squids.js",
    "lobstr:test": "node scripts/test-lobstr-connection.js",
    "analyze": "node scripts/analyze-valuations.js",
    "daily": "node scripts/scrape-and-push.js --run-now; SCRAPE_EXIT=$?; node scripts/price-tracker.js --run-now; PRICE_EXIT=$?; node scripts/broad-scraper.js --run-now; BROAD_EXIT=$?; MAX_EXIT=$(( SCRAPE_EXIT > PRICE_EXIT ? SCRAPE_EXIT : PRICE_EXIT )); exit $(( MAX_EXIT > BROAD_EXIT ? MAX_EXIT : BROAD_EXIT ))"
  },
  "keywords": [
    "scraper",
    "playwright",
    "real-estate",
    "fsbo",
    "for-sale-by-owner"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "dotenv": "^17.3.1",
    "playwright": "^1.40.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "optionalDependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5"
  }
}
